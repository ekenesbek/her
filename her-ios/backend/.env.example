# Backend
HOST=0.0.0.0
PORT=8787
DATA_DIR=./data

# Local Whisper. `turbo` is the best free practical default for this MVP:
# close to large-v3 quality, much faster, no paid STT API.
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
WHISPER_LANGUAGE=
WHISPER_CPU_THREADS=0
WHISPER_NUM_WORKERS=1
WHISPERX_BATCH_SIZE=4

# Transcription provider:
# - local: run faster-whisper / WhisperX in this backend.
# - deepgram: use Deepgram pre-recorded STT with diarization.
# - external: delegate to the standalone GPU STT service, usually on port 8000.
TRANSCRIPTION_PROVIDER=local
DEEPGRAM_API_KEY=
DEEPGRAM_BASE_URL=https://api.deepgram.com
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_TIMEOUT_SECONDS=600
EXTERNAL_TRANSCRIPTION_URL=
EXTERNAL_TRANSCRIPTION_TIMEOUT_SECONDS=1800

TRANSCRIPTION_CHUNKING_ENABLED=true
TRANSCRIPTION_CHUNK_SECONDS=30
TRANSCRIPTION_CHUNK_OVERLAP_SECONDS=3
TRANSCRIPTION_CHUNK_MIN_DURATION_SECONDS=30
TRANSCRIPTION_CHUNK_WORKERS=2

# Speaker diarization / voice profile matching. Set min/max to 0 for model auto mode.
HUGGINGFACE_TOKEN=
DIARIZATION_ENABLED=true
DIARIZATION_MIN_SPEAKERS=0
DIARIZATION_MAX_SPEAKERS=0
DIARIZATION_SINGLE_SPEAKER_RETRY_ENABLED=true
DIARIZATION_SINGLE_SPEAKER_RETRY_MIN_DURATION_SECONDS=60
DIARIZATION_SINGLE_SPEAKER_RETRY_MIN_SPEAKER_SECONDS=3
DIARIZATION_SINGLE_SPEAKER_RETRY_MAX_SPEAKERS=6
VOICE_PROFILE_MATCH_THRESHOLD=0.62
VOICE_PROFILE_SINGLE_PROFILE_MATCH_THRESHOLD=0.55
VOICE_PROFILE_SINGLE_PROFILE_MATCH_MARGIN=0.08

# OpenAI-compatible summary/chat. If no key is set, the backend uses local heuristic fallbacks.
# For platform-managed Alem OSS, set ALEM_OSS_API_KEY and keep OPENAI_SUMMARY_MODEL=gpt-oss.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_SUMMARY_MODEL=gpt-oss
ALEM_OSS_API_KEY=
ALEM_OSS_BASE_URL=https://llm.alem.ai/v1

# Backend-owned meeting processing. Keep at 1 on small CPU/GPU machines; raise
# only after checking memory pressure during real Whisper jobs.
MEETING_JOB_WORKERS=1

# Auth. APPLE_CLIENT_ID must match the iOS app bundle identifier used as the
# Sign in with Apple identity-token audience.
AUTH_JWT_SECRET=dev-secret-change-me-in-production
APPLE_CLIENT_ID=com.ekenesbek.her
GOOGLE_CLIENT_IDS=

# StoreKit plus subscription. Create this auto-renewable subscription product
# in App Store Connect, then keep the same product id in the iOS Info.plist.
APPLE_SUBSCRIPTION_PRODUCT_ID=com.ekenesbek.her.plus.monthly
APP_STORE_BUNDLE_ID=com.ekenesbek.her
APP_STORE_ENVIRONMENT=sandbox
APP_STORE_APP_APPLE_ID=
# Directory containing Apple root certificates from https://www.apple.com/pki/.
# The App Store Server Library expects DER `.cer`/`.der` root certificate files.
APP_STORE_ROOT_CERTIFICATES_DIR=
APP_STORE_ENABLE_ONLINE_CHECKS=true
# Keep disabled outside controlled local testing; StoreKit is the normal path.
LOCAL_SUBSCRIPTION_OVERRIDES_ENABLED=false
