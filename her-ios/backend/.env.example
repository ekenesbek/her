# Backend
HOST=0.0.0.0
PORT=8787
DATA_DIR=./data

# Local Whisper. `turbo` is the best free practical default for this MVP:
# close to large-v3 quality, much faster, no paid STT API.
WHISPER_MODEL=turbo
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
WHISPER_LANGUAGE=

# OpenAI-compatible summary. If OPENAI_API_KEY is empty, the backend uses a local heuristic fallback.
# For Alem, use OPENAI_BASE_URL=https://llm.alem.ai and OPENAI_SUMMARY_MODEL=gpt-oss.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_SUMMARY_MODEL=gpt-oss
