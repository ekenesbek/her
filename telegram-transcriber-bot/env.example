TELEGRAM_BOT_TOKEN=

# Unauthenticated Her STT service:
TRANSCRIPTION_URL=http://127.0.0.1:8000/v1/transcribe

# If using the authenticated iOS backend instead:
# TRANSCRIPTION_URL=http://127.0.0.1:8787/v1/transcriptions
# TRANSCRIPTION_BEARER_TOKEN=

TRANSCRIPTION_FIELD_NAME=audio
TRANSCRIPTION_TIMEOUT_SECONDS=600
MAX_AUDIO_BYTES=20971520
MAX_REPLY_CHARS=3900
ALLOWED_TELEGRAM_USER_IDS=
